# ECONVYX AI Environment Variables
# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Intelligence Service (Google Gemini Flash)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Database Configuration (Supabase / PostgreSQL)
# If not provided, ECONVYX AI uses high-performance persistent local storage in server/data/
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT & Session Security
JWT_SECRET=generate-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# File Upload & Storage
STORAGE_DIR=./uploads
DATA_DIR=./server/data
MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Frontend only: set to the deployed API origin plus /api (e.g. https://api.example.com/api).
# Leave blank for same-origin local development through the Vite proxy.
VITE_API_URL=
